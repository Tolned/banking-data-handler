[flake8]
# Конфигурационный файл линтера flake8 для проверки стиля кода (PEP 8)

# Максимально допустимая длина строки (синхронизирована с настройками Black и isort)
max-line-length = 119

# Коды ошибок, которые нужно игнорировать (для совместимости с автоформаттером Black)
ignore = E203, W503, E501, E302

# Папки и файлы, которые flake8 должен пропускать при проверке проекта
exclude = .git, __pycache__, venv, .venv
